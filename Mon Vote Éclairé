    function renderQuizPage() {
      const total = QUESTIONS.length;
      const current = QUESTIONS[state.quizCurrentIndex];
      const progress = Math.round(((state.quizCurrentIndex) / total) * 100);
      const answeredCount = Object.keys(state.userAnswers).length;
      const currentAnswer = state.userAnswers[current.id];

      const themeObj = THEMES.find(t => t.id === current.theme) || { name: 'Général' };

      const options = [
        { label: "Tout à fait d'accord", value: 2 },
        { label: "Plutôt d'accord", value: 1 },
        { label: "Neutre ou sans opinion", value: 0 },
        { label: "Plutôt pas d'accord", value: -1 },
        { label: "Pas du tout d'accord", value: -2 },
        { label: "Je ne sais pas / Je passe cette question", value: 'skip' }
      ];

      return `
        <div class="quiz-container">
          <div class="quiz-header-meta">
            <span class="theme-tag">${themeObj.name}</span>
            <span>Question <strong>${state.quizCurrentIndex + 1}</strong> sur ${total}</span>
          </div>

          <div class="progress-bar-wrap">
            <div class="progress-bar-fill" style="width: ${progress}%"></div>
          </div>

          <div class="question-card">
