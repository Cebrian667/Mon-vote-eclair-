    </div>
    <div class="footer-bottom">
      <p>© 2026-2027 Mon Vote Éclairé — Conçu selon les principes de neutralité politique, transparence et respect du RGPD.</p>
    </div>
  </footer>

  <script>
    // ==========================================
    // DONNÉES DE L'APPLICATION
    // ==========================================

    // Thèmes du questionnaire
    const THEMES = [
      { id: 'pouvoir_achat', name: "Économie, salaires & pouvoir d'achat" },
