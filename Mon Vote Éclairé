    // ==========================================
    // RÉSULTATS DU QUESTIONNAIRE
    // ==========================================
    function calculateMatches() {
      const answeredQIds = Object.keys(state.userAnswers).filter(id => state.userAnswers[id] !== 'skip');
      if (answeredQIds.length === 0) return [];

      return CANDIDATES.map(candidate => {
        let totalPossibleScore = 0;
        let userCandidateDistanceSum = 0;
        let commonQuestionsCount = 0;
        let unknownCount = 0;
        let agreements = [];
        let disagreements = [];

        answeredQIds.forEach(qId => {
          const q = QUESTIONS.find(item => item.id === parseInt(qId, 10));
          if (!q) return;

          const userVal = state.userAnswers[qId];
          const candVal = candidate.positions[qId];
          const weight = state.themeWeights[q.theme] || 1;

          // Si la position du candidat est inconnue/non documentée
          if (candVal === undefined || candVal === null) {
            unknownCount++;
            return;
          }

          commonQuestionsCount++;
          // Distance mathématique sur l'échelle [-2, 2] : max distance = 4
          const distance = Math.abs(userVal - candVal);
          // Score de proximité par question: 4 = parfait accord (dist 0), 0 = total désaccord (dist 4)
          const matchPoints = (4 - distance);

          userCandidateDistanceSum += (matchPoints * weight);
          totalPossibleScore += (4 * weight);

          if (distance <= 1) {
            agreements.push({ question: q, userVal, candVal });
          } else if (distance >= 3) {
            disagreements.push({ question: q, userVal, candVal });
          }
        });

        const coveragePercent = Math.round((commonQuestionsCount / answeredQIds.length) * 100);
        const matchPercent = totalPossibleScore > 0
          ? Math.round((userCandidateDistanceSum / totalPossibleScore) * 100)
          : 0;

        return {
          candidate,
          matchPercent,
          coveragePercent,
          commonQuestionsCount,
          unknownCount,
          agreements,
          disagreements
        };
      }).sort((a, b) => b.matchPercent - a.matchPercent);
    }

