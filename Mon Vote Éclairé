      </div>
      <div class="footer-col">
        <h4>Sources Officielles</h4>
        <ul>
          <li><a href="https://www.service-public.fr" target="_blank" rel="noopener">Service-Public.fr</a></li>
          <li><a href="https://www.interieur.gouv.fr" target="_blank" rel="noopener">Ministère de l'Intérieur</a></li>
          <li><a href="https://www.conseil-constitutionnel.fr" target="_blank" rel="noopener">Conseil constitutionnel</a></li>
